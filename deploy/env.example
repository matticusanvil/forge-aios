# Forge AIOS settings for server mode. Copy to ~/.config/forge-aios/env (chmod 600); deploy/start.sh passes it to the container.

# The project a new browser opens first. Projects are the folders beside it.
FORGE_PROJECT=/srv/repos/playground

# A long random token for scripts and the live tests: openssl rand -hex 32
FORGE_API_TOKEN=

# The address your phone uses to reach Forge (used for the Allow/Deny buttons in phone pushes).
FORGE_PUBLIC_URL=http://localhost:3200

# Phone approvals through ntfy (https://ntfy.sh or your own server). Leave NTFY_TOPIC empty to turn them off.
# On ntfy.sh, pick a long, unguessable topic name: anyone who knows it can read your approvals.
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=

# The email on commits Claude makes in your projects.
GIT_AUTHOR_EMAIL=
GIT_COMMITTER_EMAIL=
